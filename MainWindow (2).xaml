<Window x:Class="IskolaWPF13B.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IskolaWPF13B"
        mc:Ignorable="d"
        Title="IskolaWPF" Height="450" Width="300">
    <Grid>
        <StackPanel>
            <ListBox x:Name="lbxLista"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="10"
                     Height="350"
                     Width="250"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnTorles"
                        Content="Törlés"
                        Margin="15" Click="btnTorles_Click"/>
                <Button x:Name="btnMentes"
                        Content="Állomány Mentése"
                        Margin="15"
                        Click="btnMentes_Click"
                        />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
